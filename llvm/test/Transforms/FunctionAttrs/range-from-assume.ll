declare void @llvm.assume(i1)
declare void @unknown()
declare i1 @cond() willreturn nounwind

; A guaranteed-to-execute entry-block assume constrains the argument.
define void @simple(i32 %x) {
; CHECK-LABEL: define void @simple(
; CHECK-SAME: i32 range(i32 0, 2) [[X:%.*]]) #[[ATTR2:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[C:%.*]] = icmp ult i32 [[X]], 2
; CHECK-NEXT:    call void @llvm.assume(i1 [[C]])
; CHECK-NEXT:    ret void
;
entry:
  %c = icmp ult i32 %x, 2
  call void @llvm.assume(i1 %c)
  ret void
}

; Disjunctions of icmps over the same argument are unioned.
define void @or_condition(i32 %x) {
; CHECK-LABEL: define void @or_condition(
; CHECK-SAME: i32 range(i32 0, 11) [[X:%.*]]) #[[ATTR2]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[C0:%.*]] = icmp eq i32 [[X]], 0
; CHECK-NEXT:    [[C1:%.*]] = icmp eq i32 [[X]], 10
; CHECK-NEXT:    [[OR:%.*]] = or i1 [[C0]], [[C1]]
; CHECK-NEXT:    call void @llvm.assume(i1 [[OR]])
; CHECK-NEXT:    ret void
;
entry:
  %c0 = icmp eq i32 %x, 0
  %c1 = icmp eq i32 %x, 10
  %or = or i1 %c0, %c1
  call void @llvm.assume(i1 %or)
  ret void
}

