; A conjunction of disjunctions contributes each disjunctive fact.
define void @and_of_ors(i32 %x, i32 %y) {
; CHECK-LABEL: define void @and_of_ors(
; CHECK-SAME: i32 range(i32 0, 2) [[X:%.*]], i32 range(i32 8, 10) [[Y:%.*]]) #[[ATTR2]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[X0:%.*]] = icmp eq i32 [[X]], 0
; CHECK-NEXT:    [[X1:%.*]] = icmp eq i32 [[X]], 1
; CHECK-NEXT:    [[XOR:%.*]] = or i1 [[X0]], [[X1]]
; CHECK-NEXT:    [[Y0:%.*]] = icmp eq i32 [[Y]], 8
; CHECK-NEXT:    [[Y1:%.*]] = icmp eq i32 [[Y]], 9
; CHECK-NEXT:    [[YOR:%.*]] = or i1 [[Y0]], [[Y1]]
; CHECK-NEXT:    [[AND:%.*]] = and i1 [[XOR]], [[YOR]]
; CHECK-NEXT:    call void @llvm.assume(i1 [[AND]])
; CHECK-NEXT:    ret void
;
entry:
  %x0 = icmp eq i32 %x, 0
  %x1 = icmp eq i32 %x, 1
  %xor = or i1 %x0, %x1
  %y0 = icmp eq i32 %y, 8
  %y1 = icmp eq i32 %y, 9
  %yor = or i1 %y0, %y1
  %and = and i1 %xor, %yor
  call void @llvm.assume(i1 %and)
  ret void
}

