; CHECK-LABEL: define void @no_hoist_store_above_skipped_load(
; CHECK-SAME: i1 [[C:%.*]], ptr [[P:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[C]], label %[[A:.*]], label %[[B:.*]]
; CHECK:       [[COMMON_RET:.*]]:
; CHECK-NEXT:    ret void
; CHECK:       [[A]]:
; CHECK-NEXT:    [[V:%.*]] = load i1, ptr [[P]], align 1
; CHECK-NEXT:    call void @llvm.assume(i1 [[V]])
; CHECK-NEXT:    store i1 false, ptr [[P]], align 1
; CHECK-NEXT:    call void @f()
; CHECK-NEXT:    br label %[[COMMON_RET]]
; CHECK:       [[B]]:
; CHECK-NEXT:    store i1 false, ptr [[P]], align 1
; CHECK-NEXT:    call void @g()
; CHECK-NEXT:    br label %[[COMMON_RET]]
;
entry:
  br i1 %c, label %a, label %b

a:
  %v = load i1, ptr %p
  call void @llvm.assume(i1 %v)
  store i1 false, ptr %p
  call void @f()
  ret void

b:
  store i1 false, ptr %p
  call void @g()
  ret void
}

