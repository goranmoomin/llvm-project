; Identical assumes in both successors are hoisted and merged, not skipped.
define void @merge_identical_assumes(i1 %c, i32 %x) {
; CHECK-LABEL: define void @merge_identical_assumes(
; CHECK-SAME: i1 [[C:%.*]], i32 [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[V1:%.*]] = icmp ult i32 [[X]], 10
; CHECK-NEXT:    call void @llvm.assume(i1 [[V1]])
; CHECK-NEXT:    br i1 [[C]], label %[[A:.*]], label %[[B:.*]]
; CHECK:       [[COMMON_RET:.*]]:
; CHECK-NEXT:    ret void
; CHECK:       [[A]]:
; CHECK-NEXT:    call void @f()
; CHECK-NEXT:    br label %[[COMMON_RET]]
; CHECK:       [[B]]:
; CHECK-NEXT:    call void @g()
; CHECK-NEXT:    br label %[[COMMON_RET]]
;
entry:
  br i1 %c, label %a, label %b

a:
  %v1 = icmp ult i32 %x, 10
  call void @llvm.assume(i1 %v1)
  call void @f()
  ret void

b:
  %v2 = icmp ult i32 %x, 10
  call void @llvm.assume(i1 %v2)
  call void @g()
  ret void
}

; Negative test: the store must not be hoisted above the load feeding the
; assume; doing so would make the load observe the stored value and turn a
; defined execution into assume(false).
